    "title": "學習工具",
    "items": [
      {
        "glyph": "卡",
        "name": "Flashcards",
        "href": "/flashcards",
        "description": "A collection of sets I've curated and a few I've found online from other students. Some of these flashcards are also available in [PDF form](https://github.com/pjflanagan/study-mandarin/tree/gh-pages/print) and on a [Chrome Extension](https://chromewebstore.google.com/detail/fcmppkiemgfolnabclbilaodngmhfghf)."
      },
      {
        "glyph": "列",
        "name": "Lists",
        "href": "/lists",
        "description": "Every card in a set as one long list: see how well you know each one and adjust it."
      },
      {
        "glyph": "唱",
        "name": "唱歌",
        "href": "https://flanny.app/study-mandarin/page/karaoke/",
        "description": "Follow along with song lyrics in Chinese with toggleable pinyin and hover-to-reveal English translations. See more on [Google Docs](https://drive.google.com/drive/folders/1axMQBMYX7Rk4quZHPtHFPWvlqEIqbFyj?usp=share_link) or listen to [the Spotify playlist](https://open.spotify.com/playlist/7636wPWQfSQ2UXZ6Lj9Mn9?si=56c81ab3fd9b4c6f)."
      },
      {
        "glyph": "注",
        "name": "注音 Trainer",
        "href": "https://flanny.app/study-mandarin/page/zhuyin-trainer/",
        "description": "Randomly pick a character and display only the zhuyin to practice reading. You can also study up with the [zhuyin chart](https://flanny.app/study-mandarin/page/zhuyin-chart/)."
      },
      {
        "glyph": "讀",
        "name": "讀 Tool",
        "href": "https://flanny.app/study-mandarin/page/read/",
        "description": "Type or copy/paste text to see pinyin and zhuyin, reformats to traditional."
      }
    ]
  },

{
  "manifest_version": 3,
  "name": "Bamboo",
  "short_name": "Bamboo",
  "version": "2.0",
  "description": "Bamboo flashcards on every new tab: study Mandarin as you browse, with progress shared with bamboo.flanny.app.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "permissions": ["storage"],
  "host_permissions": ["https://bamboo.flanny.app/*"],
  "content_scripts": [
    {
      "matches": ["https://bamboo.flanny.app/*"],
      "js": ["progress.js", "sync.js"],
      "run_at": "document_start"
    }
  ]
}

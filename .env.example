# Where lib/data reads the public data folder from.
#   local:   ./data on disk. The default in development (next dev).
#   remote:  https://raw.githubusercontent.com/${DATA_REPO}/refs/heads/${DATA_BRANCH}/data/...
#            The default everywhere else (next build, Vercel).
# Set DATA_SOURCE to override, e.g. DATA_SOURCE=remote to try GitHub's data in dev.
# DATA_SOURCE=
DATA_REPO=pjflanagan/bamboo
DATA_BRANCH=main
